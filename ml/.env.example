# Environment variables for PayGuard AI

# Application
DEBUG=false
LOG_LEVEL=INFO

# Model
MODEL_PATH=models/production
MODEL_VERSION=v1

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Inference
BATCH_SIZE=32
MAX_INFERENCE_TIME_MS=200

# Risk Thresholds
RISK_THRESHOLD_LOW=0.4
RISK_THRESHOLD_HIGH=0.7

# Feature Engineering
USE_FEATURE_CACHE=true
FEATURE_CACHE_TTL=300

# Training
TRAINING_DATA_PATH=data/synthetic/transactions.parquet
VALIDATION_SPLIT=0.2
TEST_SPLIT=0.15
RANDOM_SEED=42

# XGBoost Parameters
XGB_MAX_DEPTH=6
XGB_LEARNING_RATE=0.1
XGB_N_ESTIMATORS=200
XGB_SCALE_POS_WEIGHT=10.0

# Monitoring
ENABLE_METRICS=true
ENABLE_LOGGING=true

# Database (Optional - for production logging)
# DATABASE_URL=postgresql://user:password@localhost:5432/payguard

# External Services (Optional)
# SENTRY_DSN=https://your-sentry-dsn
# MLFLOW_TRACKING_URI=http://localhost:5000
