# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://payguard:dev_password@localhost:5432/payguard_dev

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTIC_NODE=http://localhost:9200

# PayPal Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_SECRET=your_sandbox_secret_here
PAYPAL_WEBHOOK_ID=

# JWT
JWT_SECRET=your_jwt_secret_here_generate_with_openssl

# API Keys
API_KEY_SALT=your_api_key_salt_here_generate_with_openssl
