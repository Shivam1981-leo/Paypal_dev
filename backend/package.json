{
  "name": "payguard-backend",
  "version": "1.0.0",
  "description": "PayGuard AI Backend - Pre-Authorization Risk Intelligence API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:paypal": "tsx scripts/test-paypal.ts",
    "test:blackbox": "tsx scripts/run-blackbox-tests.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "paypal",
    "fraud-detection",
    "risk-analysis",
    "fastify"
  ],
  "author": "PayGuard AI Team",
  "license": "MIT",
  "dependencies": {
    "@elastic/elasticsearch": "^8.16.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@scalar/fastify-api-reference": "^1.25.0",
    "axios": "^1.8.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.0",
    "postgres": "^3.4.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.9.0",
    "@vitest/ui": "^2.1.0",
    "drizzle-kit": "^0.27.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
