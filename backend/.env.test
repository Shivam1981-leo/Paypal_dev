# Server
NODE_ENV=test
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Database (use separate test database)
DATABASE_URL=postgresql://payguard:dev_password@localhost:5432/payguard_test

# Redis
REDIS_URL=redis://localhost:6379/1

# Elasticsearch
ELASTIC_NODE=http://localhost:9200

# PayPal Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=test_client_id
PAYPAL_SECRET=test_secret
PAYPAL_WEBHOOK_ID=

# JWT
JWT_SECRET=test_jwt_secret_minimum_32_characters_long

# API Keys
API_KEY_SALT=test_api_key_salt_minimum_32_characters_long
